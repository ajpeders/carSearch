# carSearch configuration. Copy to `.env` and fill in what you have.
# All variables are prefixed CARSEARCH_.

# --- Server ---
CARSEARCH_PER_SITE_TIMEOUT=12
CARSEARCH_MAX_CONCURRENCY=8
# Auto-refresh the whole watchlist in the background every N hours (0 = off).
CARSEARCH_AUTO_REFRESH_HOURS=6
# ntfy topic URL for new-listing notifications (empty = off).
CARSEARCH_NTFY_URL=
# Bearer token if the ntfy server requires auth (leave blank for public topics).
CARSEARCH_NTFY_TOKEN=
CARSEARCH_USER_AGENT=carSearch/0.1 (+homelab)
# Comma-separated allowed CORS origins, or * for any.
CARSEARCH_CORS_ORIGINS=*

# --- Demo adapter ---
# Returns synthetic listings so the service works out of the box. Turn off in prod.
CARSEARCH_ENABLE_DEMO=true

# --- cars.com + CarMax via FlareSolverr ---
# Rendered public result pages via a self-hosted FlareSolverr (Cloudflare bypass).
# Best-effort; can break if the upstream HTML changes.
CARSEARCH_FLARESOLVERR_URL=
CARSEARCH_FLARESOLVERR_MAX_MS=60000
# Max concurrent FlareSolverr solves across ALL sites and saved searches.
# FlareSolverr runs a single browser, so keep this small.
CARSEARCH_FLARESOLVERR_CONCURRENCY=2
CARSEARCH_DEFAULT_ZIP=80022
CARSEARCH_ENABLE_CARS_COM=false
CARSEARCH_CARS_COM_MAX_RESULTS=25
CARSEARCH_ENABLE_CARMAX=false
CARSEARCH_CARMAX_MAX_RESULTS=25

# --- Auto.dev Vehicle Listings (real dealer-inventory JSON API, no scraping) ---
# Bearer-auth; free tier ~1,000 calls/mo. Get a key at auto.dev.
CARSEARCH_ENABLE_AUTODEV=false
CARSEARCH_AUTODEV_API_KEY=
CARSEARCH_AUTODEV_MAX_RESULTS=50

# --- MarketCheck (dealer + private-party + auction JSON API) ---
# Get a key at marketcheck.com. Adds private-party listings; real vdp_url links.
CARSEARCH_ENABLE_MARKETCHECK=false
CARSEARCH_MARKETCHECK_API_KEY=
CARSEARCH_MARKETCHECK_MAX_RESULTS=50

# --- CIS Automotive market-price enrichment (RapidAPI) ---
# Rates each listing's price against comparable dealer inventory ("Great price",
# "Above market", etc.). Uses the standard /listings2 endpoint (free tier), not
# the premium VIN valuation. Get a key at rapidapi.com/.../api/cis-automotive.
CARSEARCH_ENABLE_CIS_VALUATION=false
CARSEARCH_CIS_API_KEY=
# Leave CIS_API_ID blank when using RapidAPI.
CARSEARCH_CIS_API_ID=
